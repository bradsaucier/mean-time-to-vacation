{
  "name": "travlr-getaways",
  "version": "0.1.0",
  "private": true,
  "description": "CS 465 MEAN stack travel booking application",
  "license": "UNLICENSED",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
