{
  "name": "travlr-getaways",
  "version": "1.0.0",
  "private": true,
  "description": "CS 465 MEAN stack travel booking application",
  "license": "UNLICENSED",
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test --test-reporter=spec test/app.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/app.test.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "hbs": "^4.2.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
