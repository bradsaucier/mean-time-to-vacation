<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{description}}" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/images/logo.png" type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      {{> header}}

      <main id="main-content">
        <header class="page-intro">
          <p class="eyebrow">Travel / The reef fieldbook</p>
          <h1>Meet the island below the surface.</h1>
          <p>
            Every reef has its own rhythm. Find the experience that fits your curiosity,
            then take a closer look with a field note for the water.
          </p>
        </header>

        {{#if message}}
        <p class="trip-message" role="status">{{message}}</p>
        {{/if}}

        <ul class="listing-grid reef-fieldbook" aria-label="Reef experiences">
          {{#each trips}}
          <li class="listing-card">
            <a href="/api/trips/{{this.code}}">
              <img src="/images/{{this.image}}" alt="{{this.imageAlt}}" width="398" height="287" />
            </a>
            <div>
              <p class="eyebrow">{{this.eyebrow}}</p>
              <h2>{{this.name}}</h2>
              <p class="trip-description">{{this.description}}</p>
              <dl class="reef-profile">
                <div><dt>Experience</dt><dd>{{this.level}}</dd></div>
                <div><dt>Water profile</dt><dd>{{this.water}}</dd></div>
              </dl>
              <p class="detail-line">Best for: {{this.bestFor}}</p>
              <aside class="field-note" aria-label="Field note">
                <p class="field-note-label">A closer look</p>
                <p>{{this.fieldNote}}</p>
              </aside>
            </div>
          </li>
          {{else}}
          <li class="empty-trips">
            <h2>A new reef story is on its way.</h2>
            <p>No trips are currently available. Ask a trip specialist about future experiences.</p>
          </li>
          {{/each}}
        </ul>

        <aside class="callout">
          <div>
            <p class="eyebrow">Plan with confidence</p>
            <h2>Not sure which reef fits?</h2>
          </div>
          <p>
            Tell us your experience level and ideal pace. We will point you toward the right day.
          </p>
          <a class="button button-light" href="/contact.html">Ask a trip specialist</a>
        </aside>
      </main>

      {{> footer}}
    </div>
  </body>
</html>
