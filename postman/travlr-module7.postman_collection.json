  "item": [
    {
      "name": "Register mock user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Module Seven QA\",\"email\":\"{{email}}\",\"password\":\"MockPassw0rd!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', 'module7-' + Date.now() + '@example.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('email', JSON.parse(pm.variables.replaceIn(pm.request.body.raw)).email);",
              "pm.collectionVariables.set('token',pm.response.json().token);",
              "pm.test('JWT returned',()=>pm.expect(pm.response.json().token.split('.')).to.have.lengthOf(3));",
              "pm.test('Only a token is returned', () => pm.expect(Object.keys(pm.response.json())).to.eql(['token']));"
            ]
          }
        }
      ]
    },
